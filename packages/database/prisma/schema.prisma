// stellar-learn database schema
// Run `npm run db:generate` after changes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  username  String   @unique
  email     String   @unique
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Game state
  characterId String  @default("warrior") // selected character skin
  currentXP   Int     @default(0)
  level       Int     @default(1)
  streakDays  Int     @default(0)
  lastActiveAt DateTime?

  // Stellar testnet account (generated on first play)
  stellarPublicKey String? @unique

  // Gem economy — gemBalance is the server-authoritative source of truth.
  // Never trust a client-supplied balance; always derive it from this column
  // plus the GemTransaction ledger. Mutated only through packages/database
  // consumers that go via apps/web/src/lib/gems.ts, which keeps every change
  // in lockstep with a ledger row.
  gemBalance Int @default(0)

  // Relations
  progress        Progress[]
  achievements    UserAchievement[]
  submissions     ChallengeSubmission[]
  gemTransactions GemTransaction[]
  itemOwnerships  ItemOwnership[]

  @@map("users")
}

// ─── Curriculum ───────────────────────────────────────────────────────────────

model World {
  id          String  @id // e.g. "world-1-origin-plains"
  slug        String  @unique
  title       String
  description String
  theme       String  // "forest" | "castle" | "dungeon" | "mountain" | "castle-dungeon" | "citadel"
  order       Int
  isLocked    Boolean @default(true)
  xpReward    Int     @default(100)

  quests Quest[]

  @@map("worlds")
}

model Quest {
  id          String  @id @default(cuid())
  worldId     String
  slug        String  @unique
  title       String
  description String
  type        QuestType
  order       Int
  xpReward    Int     @default(50)
  content     Json    // lesson content, quiz questions, challenge spec

  world       World    @relation(fields: [worldId], references: [id])
  progress    Progress[]
  submissions ChallengeSubmission[]

  @@map("quests")
}

enum QuestType {
  LESSON      // guided reading/interactive lesson
  QUIZ        // multiple choice / drag-drop
  CHALLENGE   // live coding on Stellar testnet
  BOSS        // final world challenge
}

// ─── Player Progress ──────────────────────────────────────────────────────────

model Progress {
  id          String         @id @default(cuid())
  userId      String
  questId     String
  status      ProgressStatus @default(NOT_STARTED)
  xpEarned    Int            @default(0)
  completedAt DateTime?
  attempts    Int            @default(0)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id])

  @@unique([userId, questId])
  @@map("progress")
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ─── Achievements ─────────────────────────────────────────────────────────────

model Achievement {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String
  iconUrl     String
  xpReward    Int     @default(25)
  rarity      AchievementRarity @default(COMMON)

  // Trigger conditions stored as JSON rule
  // e.g. { "type": "quest_complete", "questSlug": "create-account" }
  triggerRule Json

  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

enum AchievementRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

// ─── Challenge Submissions ────────────────────────────────────────────────────

model ChallengeSubmission {
  id              String   @id @default(cuid())
  userId          String
  questId         String
  submittedCode   String
  txHash          String?  // Stellar testnet transaction hash if applicable
  passed          Boolean
  feedback        String?
  submittedAt     DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id])

  @@map("challenge_submissions")
}

// ─── Gem Economy ────────────────────────────────────────────────────────────
//
// User.gemBalance is the current balance; GemTransaction is the immutable,
// append-only audit ledger that explains how it got there. Every mutation
// (earn or spend) writes exactly one row here in the same DB transaction that
// updates the balance, so the two can never drift — replaying the ledger for
// a user must always sum to their current gemBalance.
//
// Rows are never updated or deleted. To reverse a transaction, record a new
// opposite-signed one (e.g. GemSource.REFUND) rather than editing history.

model GemTransaction {
  id     String @id @default(cuid())
  userId String

  // Signed delta applied to the balance: positive for an earn, negative for
  // a spend. resultingBalance is the balance immediately after this row was
  // applied, so the ledger can be audited without recomputing a running sum.
  amount           Int
  resultingBalance Int
  source           GemSource
  // Free-form context for the source (e.g. { "questId": "..." } or
  // { "itemId": "..." }) — never used to derive the amount, only for display
  // and audit trails.
  metadata         Json?

  // Caller-supplied dedupe key (e.g. "checkin:{userId}:2026-08-17" or a
  // marketplace purchase request id). Unique per user so a retried or
  // concurrently-repeated request is answered from the existing row instead
  // of applying the balance change twice. Null for callers that don't need
  // idempotency (e.g. one-off admin adjustments).
  idempotencyKey String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@map("gem_transactions")
}

enum GemSource {
  DAILY_CHECK_IN        // check-in streak reward
  QUEST_REWARD          // quest/lesson completion
  LEVEL_UP              // level-up bonus
  ACHIEVEMENT_UNLOCK    // achievement unlock bonus
  MARKETPLACE_PURCHASE  // spend in the cosmetic/item marketplace
  ADMIN_ADJUSTMENT      // manual correction, always logged with metadata
  REFUND                // reversal of a prior transaction
}

// ─── Marketplace Ownership ───────────────────────────────────────────────────
//
// The catalog itself (name, tier, price, asset path) lives in
// packages/content/src/marketplace/items.ts, never here — itemId is a
// foreign key into that catalog by convention, not a duplicated copy of it.
//
// A row is inserted as "pending" BEFORE any minting or gem spend happens
// (apps/web/src/app/api/marketplace/route.ts), so the @@unique([userId,
// itemId]) constraint is what actually stops a concurrent duplicate
// purchase from minting twice or getting the item for free — reserving
// the row is the gate, not an afterthought. It flips to "complete" (with
// the real Stellar identifiers filled in) only once the mint and the gem
// spend have both succeeded. A "pending" row past a short staleness
// window is treated as an abandoned/failed attempt and reclaimed by the
// next request for that (user, item) pair — see the route for the exact
// threshold and reasoning.

model ItemOwnership {
  id     String @id @default(cuid())
  userId String
  itemId String // catalog item id, e.g. "sword-legendary" — see packages/content/src/marketplace/items.ts

  // Stellar Classic unique-asset identity, "<assetCode>:<issuerPublicKey>" —
  // matches the CODE:ISSUER convention Stellar tooling uses to display an
  // asset. See packages/stellar-sdk's mintItemNFT. Null while status is
  // "pending" — the mint hasn't happened yet, so there is nothing to record.
  stellarAssetId String?
  stellarTxHash  String?

  // "pending" (reserved, not yet minted/charged) or "complete" (mint + spend
  // both succeeded). Kept as a free-form string rather than an enum so a
  // future state — e.g. "refunded" — doesn't need a migration to add.
  status String @default("pending")

  // When the reservation was made — the staleness clock for reclaiming an
  // abandoned "pending" row starts here, not at completion.
  createdAt DateTime @default(now())
  // Set only once status flips to "complete".
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@map("item_ownerships")
}
